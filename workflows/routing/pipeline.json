{
  "$schema": "../../shared/pipeline.schema.json",
  "id": "routing",
  "pattern": "routing",
  "description": "Dispatch a Penpot request to one skill or workflow.",
  "preflight": [
    "high_level_overview",
    "penpotUtils.shapeStructure",
    "penpotUtils.tokenOverview"
  ],
  "routes": [
    {
      "intent": [
        "set up tokens",
        "design system foundation",
        "infer tokens",
        "dark mode tokens"
      ],
      "target": "skill:penpot-foundations"
    },
    {
      "intent": [
        "component with variants",
        "add states",
        "variant matrix"
      ],
      "target": "skill:penpot-component-factory"
    },
    {
      "intent": [
        "design a screen",
        "landing page",
        "dashboard from brief"
      ],
      "target": "skill:penpot-build-screen"
    },
    {
      "intent": [
        "build from code",
        "translate this app page",
        "implement this UI in penpot"
      ],
      "target": "skill:penpot-build-from-code"
    },
    {
      "intent": [
        "create a presentation",
        "build a slide deck",
        "pitch deck",
        "slides for this talk",
        "turn this outline into slides"
      ],
      "target": "skill:penpot-build-deck"
    },
    {
      "intent": [
        "check accessibility",
        "wcag",
        "contrast audit"
      ],
      "target": "skill:penpot-audit-accessibility"
    },
    {
      "intent": [
        "audit tokens",
        "find hardcoded values",
        "token governance"
      ],
      "target": "skill:penpot-audit-tokens"
    },
    {
      "intent": [
        "design to code review",
        "compare to storybook",
        "drift"
      ],
      "target": "skill:penpot-design-to-code-review"
    },
    {
      "intent": [
        "document this design",
        "annotate for handoff",
        "add observation notes",
        "spec this screen"
      ],
      "target": "skill:penpot-document-handoff"
    },
    {
      "intent": [
        "generate DESIGN.md",
        "design documentation file",
        "export design guidelines as markdown",
        "style guide file"
      ],
      "target": "skill:penpot-design-md"
    },
    {
      "intent": [
        "migrate from figma",
        "figma to penpot"
      ],
      "target": "skill:penpot-migrate"
    },
    {
      "intent": [
        "does this look ai-generated",
        "anti-slop check",
        "avoid the ai look",
        "make it less generic",
        "parece hecho por ia",
        "evitar estética ia"
      ],
      "target": "skill:penpot-anti-slop"
    },
    {
      "intent": [
        "rename layers",
        "semantic names"
      ],
      "target": "skill:penpot-rename-layers"
    },
    {
      "intent": [
        "bootstrap a design system end to end"
      ],
      "target": "workflow:design-system-bootstrap"
    },
    {
      "intent": [
        "brief to a polished accessible screen"
      ],
      "target": "workflow:brief-to-screen"
    },
    {
      "intent": [
        "brief to a polished, playable deck",
        "design and validate this presentation end to end"
      ],
      "target": "workflow:brief-to-deck"
    },
    {
      "intent": [
        "keep code and penpot in sync"
      ],
      "target": "workflow:code-to-penpot-sync"
    },
    {
      "intent": [
        "full figma migration"
      ],
      "target": "workflow:figma-migration"
    },
    {
      "intent": [
        "run all audits before handoff"
      ],
      "target": "workflow:accessibility-gate"
    }
  ],
  "ambiguity_policy": "If two routes match, ask one disambiguating question before dispatching.",
  "mutation": false
}
